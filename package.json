{
  "name": "@engineio/ui",
  "version": "0.0.0-development",
  "description": "The Engine design system \u2014 tokens, fonts and Svelte primitives.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engineio/ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/tokens": "./dist/styles/tokens.css",
    "./styles/fonts": "./dist/styles/fonts.css",
    "./styles/utilities": "./dist/styles/utilities.css",
    "./fonts/*": "./dist/fonts/*",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js"
    },
    "./components/ui/*/index.js": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js"
    },
    "./components/brand": {
      "types": "./dist/components/brand/index.d.ts",
      "svelte": "./dist/components/brand/index.js"
    },
    "./components/brand/index.js": {
      "types": "./dist/components/brand/index.d.ts",
      "svelte": "./dist/components/brand/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package && publint",
    "preview": "vite preview",
    "build:gallery": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "bits-ui": "^1.4.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^0.2.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.63.0",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.2.0",
    "conventional-changelog-conventionalcommits": "9",
    "publint": "^0.3.15",
    "semantic-release": "^25.0.9",
    "svelte": "5.56.1",
    "svelte-check": "4.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
